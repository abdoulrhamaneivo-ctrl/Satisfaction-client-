# ============================================================================
# Yéba — Variables d'environnement SERVEUR (exemple)
# Copier vers .env.server et remplir avec les VRAIES valeurs.
# .env.server ne doit JAMAIS être commité (il est dans .gitignore).
# ============================================================================
# Base de données (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/yeba

# Serveur / CORS
WASP_SERVER_URL=http://localhost:3001
WASP_WEB_CLIENT_URL=http://localhost:3000
PORT=3001
JWT_SECRET=changer-moi-openssl-rand-hex-32

# Fournisseurs IA (OpenRouter — voir docs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Email transactionnel (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Stockage fichiers (AWS S3)
AWS_S3_IAM_ACCESS_KEY=
AWS_S3_IAM_SECRET_KEY=
AWS_S3_FILES_BUCKET=
AWS_S3_REGION=

# Notifications (Twilio — WhatsApp/SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Anti-rejeu (sel de hachage des téléphones) — openssl rand -hex 32
TELEPHONE_HASH_SALT=

# Uploads
MAX_FILE_SIZE_BYTES=5242880
