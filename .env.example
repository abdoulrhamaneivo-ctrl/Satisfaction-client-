# ============================================================================
# Yéba — Variables d'environnement SERVEUR
# Copier vers .env.server et remplir avec les VRAIES valeurs.
# .env.server ne doit JAMAIS être commité (il est dans .gitignore).
# ============================================================================

# ── Base de données (Neon PostgreSQL) ──
# Récupérer depuis console.neon.tech → Connection Details
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require

# ── Serveur / CORS ──
# En local : http://localhost:3001 et http://localhost:3000
# En production : remplacer par les URLs Render et Vercel
WASP_SERVER_URL=http://localhost:3001
WASP_WEB_CLIENT_URL=http://localhost:3000
PORT=3001

# ── Sécurité ──
# Générer avec : openssl rand -hex 32
JWT_SECRET=changer-moi-openssl-rand-hex-32

# ── Email transactionnel (SendGrid) ──
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yeba.ci

# ── Stockage fichiers (AWS S3) ──
# Mettre "mock" pour désactiver en dev
AWS_S3_IAM_ACCESS_KEY=mock
AWS_S3_IAM_SECRET_KEY=mock
AWS_S3_FILES_BUCKET=yeba-files
AWS_S3_REGION=eu-west-3

# ── Notifications (Twilio — WhatsApp/SMS, optionnel) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ── Anti-rejeu (sel de hachage des téléphones) ──
# OBLIGATOIRE en production. Générer avec : openssl rand -hex 32
TELEPHONE_HASH_SALT=

# ── IA sémantique (optionnel — analyse des commentaires) ──
# OpenRouter (recommandé) ou DeepSeek direct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Alternative : clé DeepSeek directe
# DEEPSEEK_API_KEY=

# ── Uploads ──
MAX_FILE_SIZE_BYTES=5242880

# ── Premier SUPER_ADMIN (seed) ──
# Email du premier compte SUPER_ADMIN créé par le seed.
# Par défaut : abdoulivo5@gmail.com
# SUPER_ADMIN_EMAIL=abdoulivo5@gmail.com
