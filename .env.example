# ============================================================================
# Yéba — Variables d'environnement SERVEUR
# Copier vers .env.server et remplir avec les VRAIES valeurs.
# .env.server ne doit JAMAIS être commité (il est dans .gitignore).
# ============================================================================

# ── Base de données (Neon PostgreSQL) ──
# Récupérer depuis console.neon.tech → Connection Details
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require

# ── Serveur / CORS ──
# En local : http://localhost:3001 et http://localhost:3000
# En production : remplacer par les URLs Render et Vercel
WASP_SERVER_URL=http://localhost:3001
WASP_WEB_CLIENT_URL=http://localhost:3000
PORT=3001

# ── Sécurité ──
# Générer avec : openssl rand -hex 32
JWT_SECRET=changer-moi-openssl-rand-hex-32
# C6a : clé DÉDIÉE au chiffrement des secrets TOTP 2FA (obligatoire, ≥ 32
# caractères — aucun fallback DEVJWTSECRET). Séparation des usages : JWT =
# sessions, TOTP_ENCRYPTION_KEY = 2FA.
TOTP_ENCRYPTION_KEY=changer-moi-openssl-rand-hex-32
# Rotation uniquement (déchiffrement seul, le temps du rechiffrement via
# src/server/scripts/rotationCleTotp.ts) — vides en temps normal :
# TOTP_ENCRYPTION_KEY_PREVIOUS=
# JWT_SECRET_PREVIOUS=

# C1/V5 (P9) : budget de l’IA globale. Par défaut : 5 appels/jour, +2 par
# entreprise active, plafond 20/jour. Le cron est quotidien, le reliquat est
# journalisé. Forcer GLOBAL_AI_BUDGET désactive le dimensionnement.
# GLOBAL_AI_BUDGET=5
# GLOBAL_AI_BUDGET_PAR_ENTREPRISE=2
# GLOBAL_AI_BUDGET_PLAFOND=20

# C1 (J+30) : Redis pour rate-limit partagé multi-instance.
# Obligatoire en prod (Railway/Render multi-instance). Format : redis://user:***@host:6379
# Optionnel en dev (MemoryStore utilisé à la place).
# ABSENT en production = avertissement au démarrage : les limites restent
# correctes en mono-instance, mais sont multipliées par le nombre d'instances.
# REDIS_URL=redis://user:***@host:6379

# C1 (Vague 5, P11-e) : nombre de proxys de confiance devant l'application.
# L'IP cliente est lue par Express, qui ne fait confiance qu'à ce nombre de
# sauts. 1 = Render/Railway (un seul proxy). 2 = un CDN (Cloudflare) est
# intercalé. Ne JAMAIS mettre `true` : l'application deviendrait exposée et
# n'importe quel appelant forgerait son IP, contournant le rate limit et
# empoisonnant le journal d'audit.
# Valeur par défaut : 1
# TRUST_PROXY_HOPS=1

# ── Email transactionnel (Brevo API HTTP — offre gratuite 300/jour) ──
# Le SMTP sortant étant bloqué depuis l'hébergeur, les envois passent par
# l'API HTTPS Brevo (port 443). Console Brevo → SMTP & API → Clés API →
# générer une clé API (xkeysib-..., PAS la clé SMTP). Les variables SMTP_*
# ci-dessous restent requises au démarrage (fallback Wasp) mais ne servent
# plus aux envois : on peut y laisser des valeurs factices en dev.
# L'expéditeur doit être vérifié dans Brevo (Expéditeurs).
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Stockage fichiers (AWS S3) ──
# Mettre "mock" pour désactiver en dev
AWS_S3_IAM_ACCESS_KEY=mock
AWS_S3_IAM_SECRET_KEY=mock
AWS_S3_FILES_BUCKET=yeba-files
AWS_S3_REGION=eu-west-3

# ── Notifications (Twilio — WhatsApp/SMS, optionnel) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ── Anti-rejeu (sel de hachage des téléphones) ──
# OBLIGATOIRE en production. Générer avec : openssl rand -hex 32
TELEPHONE_HASH_SALT=

# ── IA sémantique (optionnel — analyse des commentaires) ──
# AI_PROVIDER: 'nvidia' (Mistral via NIM direct, gratuit ~40 req/min),
# 'openrouter' (défaut historique) ou 'deepseek'. Fallback auto vers les
# autres clés configurées en cas d'échec du principal.
# AI_PROVIDER=openrouter
# NVIDIA NIM direct — clé gratuite sur build.nvidia.com (nvapi-*)
# NVIDIA_API_KEY=
# NVIDIA_MODEL=mistralai/mistral-large-2-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OpenRouter (recommandé en secours) ou DeepSeek direct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Alternative : clé DeepSeek directe
# DEEPSEEK_API_KEY=

# ── Uploads ──
MAX_FILE_SIZE_BYTES=5242880

# ── Premier SUPER_ADMIN (seed) ──
# Email du premier compte SUPER_ADMIN créé par le seed.
# Par défaut : abdoulivo5@gmail.com
# SUPER_ADMIN_EMAIL=abdoulivo5@gmail.com
