node_modules/
.worktrees/

# Wasp — artefacts de développement (le build prod est géré par le script deploy)

# `deploy/` est une COPIE de `.wasp/out` produite par `scripts/deploy-build.sh`
# pour un déploiement Render via repo séparé. Aucun chemin de déploiement
# actuel ne la consomme : `render.yaml` et `Dockerfile.render` travaillent
# depuis la racine et copient `.wasp/out`. C'est donc un artefact
# régénérable, pas une source — il ne doit pas être versionné.
deploy/
.wasp/out/node_modules/
.wasp/out/sdk/*/node_modules/
.wasp/out/server/node_modules/

# ── Secrets (JAMAIS commités — voir .env.example pour le template) ──
.env
.env.server
.env.client
.env.local
.env.development
.env.test
.env.production

# ── Archives et fichiers lourds ──
claud.zip
h.zip
*.zip

# ── Kernel / IDE ──
.kernel/
.hermes_sessions/

# ── OS ──
.DS_Store
Thumbs.db

# ── Sorties d'outillage local (jamais versionnées) ──
# `coverage/` = rapport `npm run test:coverage` ; `.opencode/` = outillage
# agentique. Un `git add -A` les embarquerait sinon.
coverage/
.opencode/

.env.local.old
.env.old-root
.railway-proxy.cjs
