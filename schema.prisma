datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// MODÈLE UTILISATEUR (FUSIONNÉ ET ADAPTÉ AU MODE SAAS)
// ============================================================================

model User {
  id                            String                   @id @default(uuid()) // Version originale d'Open SaaS (String)
  email                         String?                  @unique
  username                      String?                  @unique
  createdAt                     DateTime                 @default(now())
  isAdmin                       Boolean                  @default(false)
  sendEmail                     Boolean                  @default(false)
  
  // === CHAMPS COMPLÉMENTAIRES Yeba AJOUTÉS (Optionnels pour éviter les erreurs de compilation) ===
  nom                           String?                  @default("")
  prenom                        String?                  @default("")
  telephone                     String?                  @default("")
  role                          RoleUtilisateur?         @default(AGENT) // DIRECTION, CHEF_AGENCE, AGENT (QUALITE supprimé: fusionné dans CHEF_AGENCE)
  actif                         Boolean                  @default(true)
  // Force l'utilisateur à définir un nouveau mot de passe avant de pouvoir
  // utiliser l'application. Mis à `true` pour le tout premier compte créé
  // par le seed (le seul cas où un mot de passe généré automatiquement est
  // directement utilisable pour se connecter, sans passer par le lien
  // "mot de passe oublié" envoyé aux comptes invités).
  mustChangePassword            Boolean                  @default(false)
  id_agence                     Int?                     // Nullable pour l'onboarding SaaS (Siège créé après)
  agence                        Agence?                  @relation(fields: [id_agence], references: [id])

  // ── SAAS (Doc 11 §3) ──
  // platformRole = rôle ÉDITEUR de la plateforme (Yeba), indépendant du rôle
  // métier. NONE = compte client normal. SUPER_ADMIN/SUPPORT ont
  // id_entreprise = null (leur périmètre est la plateforme entière).
  platformRole                  String                   @default("NONE") // SUPER_ADMIN | SUPPORT | NONE

  // 2FA TOTP (audit F2) : secret TOTP chiffré AES-256-GCM avec JWT_SECRET
  // (via src/server/totp.ts). null = 2FA non activée. Obligatoire pour les
  // SUPER_ADMIN avant d'accéder à la console /platform.
  totp_secret                   String?
  totp_actif                    Boolean                  @default(false)

  // C5 (J+30) : 2FA lockout + session management
  totp_failed_attempts          Int                      @default(0)
  totp_locked_until             DateTime?
  totp_last_used_step           BigInt?

  // Dénormalisé volontairement : permet de scoper DIRECTION à leur
  // propre entreprise (tenant) sans avoir à recharger la relation agence.entreprise
  // dans chaque query/action. Toujours tenu synchronisé avec agence.id_entreprise
  // (voir src/server/middleware/rowLevelSecurity.ts).
  id_entreprise                 Int?
  entreprise                    Entreprise?              @relation(fields: [id_entreprise], references: [id])
  invitationsRecues             Invitation[]             @relation("InvitationInvite")
  invitationsEmises             Invitation[]             @relation("InvitationEmetteur")
  auditLogs                     AuditLog[]               @relation("AuditActeur")


    affectations                  AffectationGuichet[]
  modelesHoraires              ModeleHoraire[]          @relation("ModeleHoraireAgent")
  alertes                       Alerte[]
  taches                        TacheCorrective[]
  reponses                      Reponse[]                @relation("AgentResponses")
  historiquesTaches             TacheCorrectiveHistorique[] @relation("HistoriqueAuteur")

  // === RELATIONS PAR DÉFAUT D'OPEN SAAS ===
  files                         File[]
}

// ============================================================================
// STRUCTURE ORGANISATIONNELLE (Yeba)
// ============================================================================

model Entreprise {
  id                  Int               @id @default(autoincrement())
  nom_entreprise      String
  nom_court           String?
  email_administratif String?
  telephone           String?
  pays                String?           @default("Cote d'Ivoire")
  date_creation_compte DateTime         @default(now())

  // ── SAAS (Doc 11 §4) : statut, plan, limites — vérifiés côté serveur ──
  status              StatutEntreprise  @default(ACTIVE) // TRIAL | ACTIVE | SUSPENDED | CANCELLED
  plan                String            @default("STARTER") // STARTER | BUSINESS | ENTERPRISE
  date_debut_abonnement DateTime?
  date_fin_abonnement DateTime?
  limite_agences      Int               @default(5)
  limite_utilisateurs Int               @default(50)
  limite_guichets     Int               @default(25)
  suspendue_le        DateTime?
  motif_suspension    String?

  branding            BrandingConfig?
  auditLogs           AuditLog[]
  invitations         Invitation[]

  agences             Agence[]
  utilisateurs        User[]
  criteres            Critere[]
  services            Service[]
  voteAntiRejeu       VoteAntiRejeu[]
  analysesGlobales    GlobalExperienceAnalysis[]
}

model Agence {
  id                  Int               @id @default(autoincrement())
  nom_agence          String
  commune             String
  adresse             String?
  heure_ouverture     String            @default("08:00")
  heure_fermeture     String            @default("17:00")
  jours_ouvres        String            @default("1,2,3,4,5,6")

  // ──────────────────────────────────────────────────────────────
  // ARCHIVAGE LOGIQUE (jamais de suppression physique) : une agence
  // fermée définitivement est archivée plutôt que supprimée — tout son
  // historique (avis, alertes, statistiques) reste intact en base et
  // consultable, mais elle disparaît des listes actives, formulaires et
  // sélecteurs.
  // ──────────────────────────────────────────────────────────────
  archive             Boolean           @default(false)
  date_archivage      DateTime?
  
  id_entreprise       Int
  entreprise          Entreprise        @relation(fields: [id_entreprise], references: [id], onDelete: Cascade)
  
  utilisateurs        User[]
  guichets            Guichet[]
  objectifs           Objectif[]
  reponses            Reponse[]
  agencesCriteres     AgenceCritere[]
  modelesHoraires    ModeleHoraire[]
}

model Guichet {
  id                  Int               @id @default(autoincrement())
  nom_guichet         String
  type_guichet        String?
  actif               Boolean           @default(true)

  // Identifiant PUBLIC opaque pour les QR codes (Doc 11 §7) : non prédictible,
  // unique, généré à la création (et rétro-rempli par migration pour les
  // guichets existants). Un ID séquentiel n'est jamais un secret.
  code_public         String            @unique

  // Archivage logique (fermeture définitive du guichet) — voir Agence
  // ci-dessus pour la logique complète. Distinct de `actif`, qui reste
  // disponible pour une désactivation opérationnelle temporaire.
  archive             Boolean           @default(false)
  date_archivage      DateTime?
  
  id_agence           Int
  agence              Agence            @relation(fields: [id_agence], references: [id], onDelete: Cascade)
  
  affectations        AffectationGuichet[]
  modelesHoraires    ModeleHoraire[]
  reponses            Reponse[]
  alertes             Alerte[]
  services            Service[]
}

model AffectationGuichet {
  id                  Int               @id @default(autoincrement())
  date_affectation    DateTime          @db.Date
  heure_debut         String
  heure_fin           String
  
  id_guichet          Int
  guichet             Guichet           @relation(fields: [id_guichet], references: [id], onDelete: Cascade)
  
  id_agent            String            // Adapté à l'identifiant String de User
  agent               User              @relation(fields: [id_agent], references: [id], onDelete: Cascade)

  // PERFORMANCE : la soumission d'avis cherche l'affectation courante par
  // (guichet, date, plage horaire) à CHAQUE scan QR ; le planning et les
  // jobs (alerteSilence) filtrent par (guichet, date).
  @@index([id_guichet, date_affectation])
}

// ============================================================================
// SEMAINE TYPE (grille horaire hebdomadaire récurrente)
// ============================================================================
// Évite de ressaisir le même planning chaque matin : le chef définit UNE
// fois qui travaille où et quand pour chaque jour de semaine, puis le
// système génère les AffectationGuichet (job quotidien + bouton manuel).
// jour_semaine suit la convention JS getUTCDay déjà utilisée par
// alerteSilence et jours_ouvres : 0 = dimanche, 1 = lundi … 6 = samedi.
model ModeleHoraire {
  id                  Int               @id @default(autoincrement())

  id_agence           Int
  agence              Agence            @relation(fields: [id_agence], references: [id], onDelete: Cascade)

  jour_semaine        Int               // 0 (dimanche) … 6 (samedi)
  heure_debut         String            // "HH:MM"
  heure_fin           String            // "HH:MM"

  id_guichet          Int
  guichet             Guichet           @relation(fields: [id_guichet], references: [id], onDelete: Cascade)

  id_agent            String
  agent               User              @relation("ModeleHoraireAgent", fields: [id_agent], references: [id], onDelete: Cascade)

  @@index([id_agence, jour_semaine])
}

// ============================================================================
// CONTEXTE D'ÉVALUATION (Yeba)
// ============================================================================

model Service {
  id                  Int               @id @default(autoincrement())
  libelle_service     String

  // NULL = service "socle" fourni par la plateforme (visible par toutes les
  // entreprises, ex. seed initial). Une valeur = service propre à une
  // entreprise, invisible aux autres. Voir Critere pour le même principe.
  id_entreprise       Int?
  entreprise          Entreprise?       @relation(fields: [id_entreprise], references: [id], onDelete: Cascade)

  reponses            Reponse[]
  guichets            Guichet[]
  // Voir CritereService : relation explicite avec ordre d'affichage.
  criteresServices    CritereService[]
}

model Critere {
  id                  Int               @id @default(autoincrement())
  libelle_critere     String
  description         String?
  
  // === NOUVEAUX CHAMPS DYNAMIQUES ===
  // SMILEY, OUI_NON, QCM (choix unique), TEXTE (texte libre),
  // CASES (choix multiples / checkboxes), ECHELLE (échelle linéaire, ex. 1-10),
  // NPS (0-10 : détracteurs/passifs/promoteurs)
  type_reponse        TypeReponse       @default(SMILEY)
  // Mode de scoring fin (vague 1) : NULL = déduit du type_reponse.
  // Pour CASES : 'CATEGORICAL' (stats %, jamais noté) ou 'WEIGHTED'
  // (poids +/-, base 100 + Σ clampé 0-100). Valeurs : ORDINAL | BINARY |
  // NUMERIC | SMILEY | NPS | CASES_CATEGORICAL | CASES_WEIGHTED | FREE_TEXT.
  scoring_mode        ScoringMode?
  // Orientation de la note : HIGHER_BETTER (défaut) ou LOWER_BETTER
  // (ex. « Avez-vous rencontré un problème ? » Oui = négatif).
  orientation         String            @default("HIGHER_BETTER")
  // Version du scoring : incrémentée à chaque modification des options ou
  // du mode. Stampée sur Reponse.critere_version pour la traçabilité
  // historique (un questionnaire modifié ne réinterprète pas le passé).
  version             Int               @default(1)
  // QCM / CASES : choix séparés par des virgules.
  // ECHELLE : "min,max" (ex. "1,10"). Vide = échelle 1-5 par défaut.
  options_reponse     String?
  // SCORING ADMIN-PROOF (voir src/shared/scoringQCM.ts) : scores sémantiques
  // (1 = pire … 5 = meilleur) PARALLÈLES aux options, même convention CSV.
  // Ex. options "Très satisfait,Neutre,Très insatisfait" → "5,3,1".
  // Le score ne dépend donc JAMAIS de l'ordre saisi par l'admin. Rempli à la
  // création/édition (explicite ou inférence lexicale FR stockée) ; NULL =
  // critère non valencé (ex. CASES « motifs ») → exclu des moyennes.
  scores_reponse      String?
  // Question obligatoire (bloque la progression tant qu'il n'y a pas de
  // réponse) ou facultative (un bouton "Passer" est proposé côté collecte).
  obligatoire         Boolean           @default(true)

  // NULL = critère "socle" fourni par la plateforme (visible par toutes les
  // entreprises, ex. les 3 critères FD X50-167 créés au seed). Une valeur =
  // critère créé par une entreprise via createCritere, invisible aux autres
  // entreprises (isolation demandée : chaque DIRECTION ne voit que le
  // catalogue commun + les critères de sa propre entreprise).
  // Archivage logique : une question archivée ne s'affiche plus dans les formulaires de collecte (QR Code / Guichet) mais conserve son historique de données.
  archive             Boolean           @default(false)
  date_archivage      DateTime?

  id_entreprise       Int?
  entreprise          Entreprise?       @relation(fields: [id_entreprise], references: [id], onDelete: Cascade)

  objectifs           Objectif[]
  reponses            Reponse[]
  agencesCriteres     AgenceCritere[]
  // Relation explicite (et non plus many-to-many implicite) pour pouvoir
  // stocker un ordre d'affichage par opération : c'est ce qui permet de
  // glisser-déposer les questions pour les réordonner ou les déplacer
  // d'une opération à l'autre (voir CritereService plus bas).
  criteresServices    CritereService[]
  // Options métier (vague 1) : source de vérité du scoring (voir
  // OptionCritere ci-dessous). options_reponse/scores_reponse (CSV)
  // restent en lecture pour rétrocompatibilité.
  options             OptionCritere[]
}

// ============================================================================
// OPTIONS MÉTIER D'UN CRITÈRE (vague 1 — scoring admin-proof)
// ============================================================================
// Chaque option a une identité stable (id cuid) : l'ordre d'affichage peut
// changer sans modifier les scores. Unicité sur le libellé NORMALISÉ
// (minuscules, sans accents) : « Très satisfait » ≡ « tres satisfait ».
// Règle d'or : ne JAMAIS supprimer physiquement une option déjà utilisée
// par un avis — passer actif=false (l'historique reste interprétable).
// ============================================================================

model OptionCritere {
  id                String   @id @default(cuid())

  id_critere        Int
  critere           Critere  @relation(fields: [id_critere], references: [id], onDelete: Cascade)

  libelle           String
  libelle_normalise String
  ordre_affichage   Int      @default(0)
  actif             Boolean  @default(true)

  // false = option purement catégorielle (ex. motif « Retrait ») : jamais
  // notée, sert aux stats de répartition uniquement.
  est_scorable      Boolean  @default(true)

  // Score sémantique 1..5 (NULL = non valencé). Indépendant de
  // ordre_affichage : c'est CE champ qui fait foi, jamais la position.
  score             Int?
  // Provenance du score : EXPLICIT (saisi par l'admin) | INFERRED
  // (inférence lexicale) | MIGRATED (backfill CSV→options). NULL = non
  // scoré. Permet au moteur de stamp score_source honnêtement.
  score_provenance  String?

  // CASES_WEIGHTED : poids + (atout) ou - (irritant), ex. -25.
  poids             Int?

  valeur_metier     String?
  code_metier       String?

  reponses          ReponseOption[]

  @@unique([id_critere, libelle_normalise])
  @@index([id_critere, ordre_affichage])
}

// ============================================================================
// JONCTION RÉPONSE <-> OPTIONS (vague 1)
// ============================================================================
// QCM : exactement 1 ligne. CASES : 1 ligne par case cochée.
// Les statistiques travaillent sur ces identifiants, JAMAIS sur le texte
// joint « • » (conservé dans Reponse.commentaire_texte pour affichage et
// historique uniquement).
// ============================================================================

model ReponseOption {
  id_reponse  BigInt
  reponse     Reponse       @relation(fields: [id_reponse], references: [id], onDelete: Cascade)

  id_option   String
  option      OptionCritere @relation(fields: [id_option], references: [id], onDelete: Restrict)

  @@id([id_reponse, id_option])
  @@index([id_option])
}

// Table de jonction explicite Critère <-> Opération (Service). Remplace
// l'ancienne relation many-to-many implicite (_CritereToService) pour
// pouvoir porter un champ `ordre` par paire (critère, opération) : c'est ce
// qui permet à l'UI de type "todo" de réordonner les questions au sein
// d'une opération et de les déplacer d'une opération à une autre par
// glisser-déposer.
model CritereService {
  id          Int      @id @default(autoincrement())

  id_critere  Int
  critere     Critere  @relation(fields: [id_critere], references: [id], onDelete: Cascade)

  id_service  Int
  service     Service  @relation(fields: [id_service], references: [id], onDelete: Cascade)

  // Position d'affichage de la question au sein de cette opération
  // (0 = première question affichée). Modifié par reorderCriteresService.
  ordre       Int      @default(0)

  @@unique([id_critere, id_service])
  @@index([id_service, ordre])
}

model AgenceCritere {
  id_agence  Int
  agence     Agence  @relation(fields: [id_agence], references: [id], onDelete: Cascade)
  id_critere Int
  critere    Critere @relation(fields: [id_critere], references: [id], onDelete: Cascade)

  @@id([id_agence, id_critere])
}

model Objectif {
  id                  Int               @id @default(autoincrement())
  valeur_cible        Decimal           @db.Decimal(5, 2)
  date_debut          DateTime          @db.Date
  date_fin            DateTime          @db.Date
  
  id_critere          Int
  critere             Critere           @relation(fields: [id_critere], references: [id], onDelete: Cascade)
  
  id_agence           Int
  agence              Agence            @relation(fields: [id_agence], references: [id], onDelete: Cascade)
}

model Canal {
  id                  Int               @id @default(autoincrement())
  type_canal          String            // QR_WEB, USSD, IVR_VOCAL
  langue_utilisee     String
  
  reponses            Reponse[]
}

// ============================================================================
// FLUX TRANSACTIONNEL (Yeba)
// ============================================================================

model Reponse {
  id                  BigInt            @id @default(autoincrement())
  date_reponse        DateTime          @default(now())
  // LEGACY (lecture seule) : historiquement NOT NULL, ce qui forçait des
  // 3 fantômes sur TEXTE/CASES. Nullable depuis la vague 1 : NULL = non
  // notable. Les anciennes lignes gardent leur valeur + score_source =
  // LEGACY_POSITIONAL (jamais réécrites).
  score_brut          Int?
  // Score officiel (vague 1) : calcul déterministe serveur via OptionCritere.
  // NULL = réponse non notable (TEXTE, CASES catégoriel, QCM non valencé).
  // L'IA ne l'écrit JAMAIS (pas de source AI dans score_source).
  score_officiel      Int?
  // Score normalisé canonique /100 (vague 1) : ECHELLE via ratio,
  // 1..5 via (s-1)/4*100, NPS via catégorie. NULL si non notable.
  score_normalise     Float?
  // EXPLICIT (config métier) | INFERRED (inférence lexicale stockée) |
  // LEGACY_POSITIONAL (ancien index+1) | MIGRATED (backfill CSV→options).
  score_source        String?
  // Version du critère au moment de la réponse (traçabilité historique).
  critere_version     Int?
  commentaire_texte   String?
  id_soumission       String?
  
  id_critere          Int
  critere             Critere           @relation(fields: [id_critere], references: [id])
  
  id_canal            Int
  canal               Canal             @relation(fields: [id_canal], references: [id])
  
  id_agence           Int
  agence              Agence            @relation(fields: [id_agence], references: [id], onDelete: Cascade)
  
  id_guichet          Int
  guichet             Guichet           @relation(fields: [id_guichet], references: [id])
  
  id_service          Int?
  service             Service?          @relation(fields: [id_service], references: [id])
  
  id_agent            String?           // Adapté à l'identifiant String de User
  agent               User?             @relation("AgentResponses", fields: [id_agent], references: [id], onDelete: SetNull)
  
  alertes             Alerte[]
  analyseIA           AnalyseAvisIA?
  optionsChoisies     ReponseOption[]

  // PERFORMANCE : toutes les stats (dashboard, rapport, radar) filtrent par
  // (agence, période) ou (guichet, période) ; le rattachement avis→agent du
  // planning (RG11) filtre par (guichet, soumission).
  @@index([id_agence, date_reponse])
  @@index([id_guichet, date_reponse])
  @@index([id_soumission])
}

// ============================================================================
// ANALYSE IA SÉMANTIQUE (DeepSeek — Async Job PgBoss)
// ============================================================================

/// Domaines de valeurs (audit P14 j).
///
/// Les valeurs viennent du CODE, jamais des commentaires de schéma — un
/// commentaire finit par mentir, un enum non. Trois exemples de ce que la
/// lecture des commentaires aurait raté, tous attrs par la compilation :
///
/// - `type_reponse` valait 5 valeurs dans mes premieres annotations ; le code en
///   utilise 7 : `OUI_NON` et `NPS` sont réels (`moteurGlobal.ts:272`
///   filtre sur `type_reponse === 'NPS'`). Source de vérité : les CLÉS de
///   `MODES_PAR_TYPE` dans `actions.ts`.
/// - `scoring_mode` : `MAGIQUE` figurait dans un commentaire de ce fichier.
///   Il n'est dans aucune liste du code, donc ici il est REFUSÉ.
/// - `statut_tache` : `EN_COURS` est produit par deux jobs et absent de ma
///   première extraction, qui ne voyait pas les valeurs posées sur la ligne
///   suivante.
///
/// `HIGH_BETTER`/`LOWER_BETTER` n'apparaissent pas ici : elles appartiennent
/// au champ `orientation`, pas à `scoring_mode`.
enum StatutIa {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Gravité d'un problème remonté par l'analyse. Partagée par `severite` et
/// `urgence` d'`AnalyseAvisIA` : même domaine, donc même contrainte.
/// `MEDIUM` est documenté et accepté mais pas encore produit par le code.
enum NiveauGravite {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RoleUtilisateur {
  AGENT
  CHEF_AGENCE
  DIRECTION
}

enum StatutEntreprise {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Type de question. Source de vérité : les clés de `MODES_PAR_TYPE`
/// (`actions.ts`), qui associent chaque type à ses modes de score admis.
enum TypeReponse {
  SMILEY
  OUI_NON
  ECHELLE
  QCM
  CASES
  TEXTE
  NPS
}

/// Mode de score. Source de vérité : `MODES_SCORING_VALIDES` (`actions.ts`).
/// `CASES_CATEGORICAL` (catégories) et `CASES_WEIGHTED` (poids par cas) sont
/// deux modes distincts du même type de question.
enum ScoringMode {
  ORDINAL
  BINARY
  NUMERIC
  SMILEY
  NPS
  CASES_CATEGORICAL
  CASES_WEIGHTED
  CES
  FREE_TEXT
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  TERMINEE
}

/// `ancien_statut` est l'état AVANT une transition : pour une tâche créée,
/// la réponse est `CREATION` — ce n'est pas un statut de tâche, mais une
/// absence de statut. D'où un domaine distinct de `nouveau_statut`.
enum StatutAvantTache {
  CREATION
  A_FAIRE
  EN_COURS
  TERMINEE
}

enum StatutAlerte {
  NOUVELLE
  TRAITEE
}

enum TypeAlerte {
  NOTE_CRITIQUE
  SILENCE_EVALUATION
  IA_INCOHERENCE_NOTE
  IA_URGENCE
}

model AnalyseAvisIA {
  id                 BigInt   @id @default(autoincrement())
  reponseId          BigInt   @unique
  reponse            Reponse  @relation(fields: [reponseId], references: [id], onDelete: Cascade)
  commentaireTexte   String?
  
  // Note (score du critère noté) conservée au moment de l'analyse pour le
  // croisement note ↔ texte — sans elle, la cohérence ne peut pas être
  // recalculée si la Reponse source évolue.
  noteBrut           Int?
  
  status             StatutIa @default(PENDING)
  sentiment          String?  // POSITIVE, NEUTRAL, NEGATIVE, MIXED
  sentimentScore     Float?   // 0.0 à 1.0
  themes             String?  // JSON Array des thèmes contrôlés
  // Vague 1 Phase F : analyse individuelle enrichie (§23).
  sousThemes         String?  // JSON Array (max 5) de précisions
  problemePrincipal  String?
  problemesSecondaires String? // JSON Array (max 3) de textes courts
  severite           NiveauGravite?
  emotion            String?  // émotion dominante perçue (1-2 mots)
  confidence         Float?   // confiance globale 0.0-1.0 dans l'analyse
  urgence            NiveauGravite?
  resume             String?
  actionRecommandee  String?
  // Traçabilité modèle (vague 1, §47-48) : prompt + analyse versionnés
  // pour comparer les résultats dans le temps.
  promptVersion      String?
  analysisVersion    String?  @default("1")
  
  // Cohérence note ↔ commentaire (croisement serveur, Doc IA-2) :
  // null = pas d'évaluation (pas de note ou pas de texte). Valeurs :
  // NOTE_PLUS_HAUTE_QUE_TEXTE (ex. 5/5 + texte rancunier), NOTE_PLUS_BASSE_QUE_TEXTE.
  coherenceNote      String?
  // Sentiment RETENU après croisement (peut différer de "sentiment" brut) :
  // un 5/5 rancunier est compté NEGATIVE dans les statistiques.
  sentimentRetenu    String?
  
  model              String   @default("deepseek-chat")
  provider           String   @default("deepseek")
  attempts           Int      @default(0)
  error              String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  processedAt        DateTime?

  @@index([status])
}

// ============================================================================
// ANALYSE GLOBALE D'EXPÉRIENCE (vague 1, Phase G)
// ============================================================================
// Une ligne = une synthèse IA sur une période + périmètre, TOUJOURS adossée
// à un snapshot d'indicateurs déterministes (datasetSnapshot + indicateurs
// JSON) : chaque conclusion est reconstructible (pourquoi l'IA a dit ça).
// L'IA verbalise et priorise, ne mesure jamais (volumes/scores viennent du
// ScoreEngine). Reruns idempotents via @@unique (entreprise, periode, debut).
// ============================================================================

model GlobalExperienceAnalysis {
  id                  BigInt   @id @default(autoincrement())

  id_entreprise       Int
  entreprise          Entreprise @relation(fields: [id_entreprise], references: [id], onDelete: Cascade)

  periode             String   // SEMAINE | MOIS
  debut               DateTime
  fin                 DateTime

  filtres             String?  // JSON {agences?: number[], services?: number[]}
  datasetSnapshot     String?  // JSON {volumeAvis, volumeNotables, ...}
  indicateurs         String?  // JSON {csat, nps, coherence, qualite, ...}

  resumeExecutif      String?
  pointsPositifs      String?  // JSON string[]
  pointsNegatifs      String?  // JSON string[]
  irritants           String?  // JSON [{theme, frequence, gravite, evolution, etendue, confiance, priorite}]
  tendances           String?  // JSON string[]
  anomalies           String?  // JSON string[]
  priorites           String?  // JSON string[] (actions recommandées ordonnées)
  confiance           String?  // FAIBLE | MOYENNE | ELEVEE
  limites             String?  // JSON string[] (données manquantes, réserves)

  volumeAvis          Int      @default(0)
  volumeCommentaires  Int      @default(0)
  qualiteDonnees      Float?

  model               String?
  provider            String?
  promptVersion       String?
  analysisVersion     String   @default("1")

  status              StatutIa @default(PENDING)
  // Vague 1 (P4) : compteur de tentatives. Sans lui, un échec de fournisseur
  // rendait la synthese definitive (le job ne traitait que PENDING) et le
  // declencheur manuel repondait « deja disponible » sur une ligne morte.
  attempts            Int      @default(0)
  error               String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  processedAt         DateTime?

  @@unique([id_entreprise, periode, debut])
  @@index([id_entreprise, periode, fin])
}

model Alerte {
  id                  BigInt            @id @default(autoincrement())
  message             String
  statut_alerte       StatutAlerte      @default(NOUVELLE)
  type_alerte         TypeAlerte
  date_creation       DateTime          @default(now())
  date_traitement     DateTime?

  // Archivage logique : une alerte TRAITEE ancienne est archivée
  // (automatiquement par le job quotidien, ou manuellement) pour alléger
  // les vues actives — jamais supprimée, toujours consultable dans
  // Archives et comptée dans les rapports/statistiques.
  archive             Boolean           @default(false)
  date_archivage      DateTime?
  
  id_reponse          BigInt?
  reponse             Reponse?          @relation(fields: [id_reponse], references: [id], onDelete: Cascade)
  
  id_destinataire     String            // Adapté à l'identifiant String de User
  destinataire        User              @relation(fields: [id_destinataire], references: [id], onDelete: Cascade)
  
  id_guichet_concerne Int?
  guichet             Guichet?  @relation(fields: [id_guichet_concerne], references: [id], onDelete: SetNull)

  taches              TacheCorrective[]

  @@index([archive])
}

model TacheCorrective {
  id                  BigInt            @id @default(autoincrement())
  titre               String
  description         String?
  statut_tache        StatutTache       @default(A_FAIRE)
  date_creation       DateTime          @default(now())
  date_echeance       DateTime
  date_cloture        DateTime?

  // IDEMPOTENCE JOB RELANCE (audit P5) : horodatage de la dernière relance
  // envoyée. Le job quotidien saute les tâches relancées il y a moins de
  // 72h — un redémarrage/crash/replay du worker ne provoque jamais de
  // double email/SMS au même responsable.
  date_derniere_relance DateTime?

  // Archivage logique — même principe que Alerte ci-dessus.
  archive             Boolean           @default(false)
  date_archivage      DateTime?
  
  id_alerte           BigInt
  alerte              Alerte            @relation(fields: [id_alerte], references: [id], onDelete: Cascade)
  
  id_responsable      String            // Adapté à l'identifiant String de User
  responsable         User              @relation(fields: [id_responsable], references: [id])

  historique          TacheCorrectiveHistorique[]

  @@index([archive])
}

// ============================================================================
// HISTORIQUE & AUDIT DES TÂCHES CORRECTIVES (Conformité ARTCI)
// Enregistre chaque changement de statut avec horodatage, auteur et
// commentaire optionnel — permet de reconstituer l'historique complet en
// cas de litige ou d'audit qualité.
// ============================================================================

model TacheCorrectiveHistorique {
  id              BigInt          @id @default(autoincrement())
  date_action     DateTime        @default(now())
  ancien_statut   StatutAvantTache
  nouveau_statut  StatutTache
  commentaire     String?

  id_tache        BigInt
  tache           TacheCorrective @relation(fields: [id_tache], references: [id], onDelete: Cascade)

  id_auteur       String
  auteur          User            @relation("HistoriqueAuteur", fields: [id_auteur], references: [id])

  @@index([id_tache, date_action])
}

// ============================================================================
// ANTI-REJEU DES VOTES (Yeba — Conformité ARTCI)
// ============================================================================
// C2 (J+30) : scope par entreprise + fenêtre journalière.
// Unicité : (id_entreprise, hachage_tel, fenetre) où fenetre = date_vote::date
// HMAC-SHA256(sel, E.164) — sel = ANTI_REPLAY_SALT (obligatoire, 32 octets min).
model VoteAntiRejeu {
  id           BigInt   @id @default(autoincrement())
  id_entreprise Int
  entreprise   Entreprise @relation(fields: [id_entreprise], references: [id], onDelete: Cascade)
  hachage_tel  String   // HMAC-SHA256(sel, telephone_E164)
  date_vote    DateTime @default(now())

  @@unique([id_entreprise, hachage_tel, date_vote])
  @@index([date_vote])
}


// ============================================================================
// TABLES TECHNIQUES ET ANALYTICS REQUISES PAR LE TEMPLATE OPEN SAAS
// ============================================================================

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   // Adapté à l'identifiant String de User
  name      String
  s3Key     String   // Nom du champ d'origine requis par Open SaaS
  type      String   // Ajout du champ de type MIME pour le module d'upload
  url       String?
}

model Logs {
  id           Int         @id @default(autoincrement())
  createdAt    DateTime    @default(now())
  message      String
  level        String
}

// ============================================================================
// SAAS — INVITATIONS, AUDIT, BRANDING (Doc 11 §5/§8, Doc 13)
// ============================================================================

/// Invitation sécurisée à usage unique : le token EN CLAIR va uniquement dans
/// le lien de l'email ; la base ne stocke que son SHA-256 (token_hash).
/// À l'activation : hash(token_clair) == token_hash && expires_at > now
/// && used_at == null, puis used_at = now + définition du mot de passe.
model Invitation {
  id             BigInt    @id @default(autoincrement())
  id_user        String    // User INVITÉ (celui qui doit activer son compte)
  invite         User      @relation("InvitationInvite", fields: [id_user], references: [id])
  id_emetteur    String    // SUPER_ADMIN (ou DIRECTION) qui a émis l'invitation
  emetteur       User      @relation("InvitationEmetteur", fields: [id_emetteur], references: [id])
  // NULL = invitation PLATEFORME (Super Admin Yéba, pas de tenant) ;
  // non-null = invitation d'entreprise. Le hack id_entreprise = 0 est aboli.
  id_entreprise  Int?
  entreprise     Entreprise? @relation(fields: [id_entreprise], references: [id])
  token_hash     String    @unique
  expires_at     DateTime
  used_at        DateTime?
  created_at     DateTime  @default(now())

  @@index([id_user])
  @@index([expires_at])
  @@index([id_entreprise, created_at])
}

/// Journal des actions sensibles (Doc 11 §8). Écrit via le helper
/// journaliser() uniquement — jamais dispersé dans les actions.
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  actor_id      String
  acteur        User     @relation("AuditActeur", fields: [actor_id], references: [id])
  actor_role    String?  // SUPER_ADMIN, DIRECTION... (copie au moment du fait)
  action        String   // 'entreprise.create', 'entreprise.suspend', 'user.invite', 'branding.update', 'invitation.used', ...
  resource      String   // 'Entreprise', 'User', 'Guichet', ...
  resource_id   String?
  entreprise_id Int?     // null = action platform (hors tenant)
  entreprise    Entreprise? @relation(fields: [entreprise_id], references: [id], onDelete: SetNull)
  details       Json?    // diff avant/après (sans secret), motif de suspension...
  ip            String?
  user_agent    String?
  created_at    DateTime @default(now())

  @@index([entreprise_id, created_at])
  @@index([actor_id, created_at])
  @@index([action, created_at])
}

/// Personnalisation par entreprise (Doc 13). Champs null = hérite du thème
/// Yeba par défaut (src/shared/branding.ts). Validation stricte côté serveur
/// (HEX, longueurs, MIME logos) — jamais de CSS/HTML libre.
model BrandingConfig {
  id             BigInt  @id @default(autoincrement())
  id_entreprise  Int     @unique
  entreprise     Entreprise @relation(fields: [id_entreprise], references: [id], onDelete: Cascade)

  // ── Identité ──
  logo_url       String?
  logo_light_url String?
  favicon_url    String?
  nom_affiche    String?

  // ── Couleurs (format "H S% L%" compatible branding.ts, ou null) ──
  color_primary   String?
  color_secondary String?
  color_accent    String?
  color_background String?

  // ── Messages expérience client (bornés) ──
  form_title      String? @db.VarChar(120)
  form_subtitle   String? @db.VarChar(200)
  form_thank_you  String? @db.VarChar(120)
  qr_slogan       String? @db.VarChar(80)

  // ── QR global (surcharge par guichet = GuichetQrStyle, phase P2) ──
  qr_style        String  @default("CLASSIQUE") // CLASSIQUE | MODERNE | PREMIUM
  qr_color        String?
  qr_bg_color     String?
  qr_frame        String  @default("SIMPLE")    // AUCUN | SIMPLE | PREMIUM

  hide_yeba_branding Boolean @default(false)   // plan ENTERPRISE uniquement

  updated_by      String?
  updated_at      DateTime @updatedAt
  created_at      DateTime @default(now())
}
